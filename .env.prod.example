# Copy this file to .env in the same directory as docker-compose.prod.yml
# (never commit the real .env - it's already gitignored via the plain
# ".env" rule). docker compose reads it automatically and substitutes
# ${DB_PASSWORD} / ${JWT_SECRET} in docker-compose.prod.yml.

# A strong, random password for the Postgres user this stack creates.
DB_PASSWORD=

# A long, random secret used to sign JWTs. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=
