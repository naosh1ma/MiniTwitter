{
	# Caddy auto-enables HTTP/3 (QUIC over UDP/443) and advertises it via
	# Alt-Svc by default. curl ignores that header and just uses HTTP/2 over
	# TCP, so it always works fine - but real browsers eagerly try to upgrade
	# to HTTP/3, and if the host's cloud firewall only has a TCP/443 rule (an
	# easy thing to do by accident - UDP/443 is a separate rule), the QUIC
	# handshake silently hangs with no fallback, and the browser shows a
	# blank page while curl shows nothing wrong at all. This app has no need
	# for HTTP/3, so it's simplest to just turn it off entirely.
	servers {
		protocols h1 h2
	}
}

naosh1ma.de {
	# Caddy provisions and renews TLS automatically for a real public domain -
	# no separate certbot/nginx-proxy step needed.

	handle /api/* {
		reverse_proxy backend:8080
	}

	# Uploaded avatars/post images are served by the backend at /uploads/**
	# (see WebMvcConfig) - same origin as the app, so the frontend can
	# reference them with a plain relative path regardless of the
	# /minitwitter prefix below.
	handle /uploads/* {
		reverse_proxy backend:8080
	}

	# The bare path (no trailing slash) matches none of handle_path's
	# wildcard below, and Caddy would otherwise fall through to an empty
	# 200 OK - redirect it to the slash-terminated form first.
	redir /minitwitter /minitwitter/ permanent

	# handle_path strips the /minitwitter prefix before forwarding, so the
	# frontend container always sees requests as if it were at "/" - it has
	# no idea it's being served under a path prefix. Angular itself was told
	# about the prefix at build time via BASE_HREF (see docker-compose.prod.yml)
	# so its router and asset URLs already expect it.
	handle_path /minitwitter/* {
		reverse_proxy frontend:80
	}

	# Root "/" is intentionally not handled here - it's reserved for whatever
	# else you put at naosh1ma.de later (a homepage, etc.) and this stack
	# doesn't claim it. Add your own `handle { ... }` block for it when ready.
}
